{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline queue proposal v1 and phased v2",
  "description": "Also subject to a 256 KiB UTF-8 bound, exact lease/context identity, source hashes, write-set and unique retained-text checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "job_id", "attempt_id", "lease", "context_fingerprint", "status", "edits", "reason", "risks", "test_plan", "follow_up"],
  "properties": {
    "version": {"enum": [1, 2], "type": "integer"},
    "job_id": {"type": "string", "pattern": "^j[0-9a-f]{24}$"},
    "attempt_id": {"type": "string", "pattern": "^a[0-9a-f]{24}$"},
    "lease": {"type": "string", "pattern": "^[0-9a-f]{48}$"},
    "context_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["proposed", "deferred", "failed"]},
    "edits": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "before_sha256", "replacements"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 500},
          "phase": {"enum": ["test", "implementation"]},
          "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "replacements": {
            "type": "array", "minItems": 1, "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["old", "new"],
              "properties": {"old": {"type": "string", "minLength": 1}, "new": {"type": "string"}}
            }
          }
        }
      }
    },
    "reason": {"type": "string", "pattern": "^([A-Za-z0-9_.-]{1,128})?$"},
    "risks": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 1000}},
    "test_plan": {"type": "string", "minLength": 1, "maxLength": 4000},
    "follow_up": {
      "type": "array", "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "name", "note"],
        "properties": {
          "action": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "note": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"version": {"const": 2}}},
    "then": {"properties": {"edits": {"items": {"required": ["phase"]}}}},
    "else": {"properties": {"edits": {"items": {"not": {"required": ["phase"]}}}}}
  }, {
    "if": {"properties": {"status": {"const": "proposed"}}},
    "then": {"properties": {"edits": {"minItems": 1}}},
    "else": {"properties": {"edits": {"maxItems": 0}, "reason": {"minLength": 1}}}
  }]
}
