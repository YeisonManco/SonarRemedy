{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Debt queue: preview manual runner",
      "type": "process",
      "command": "sonarremedy",
      "args": ["run", "--state", "${input:queue}"],
      "problemMatcher": []
    },
    {
